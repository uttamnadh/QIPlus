{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MuseQAConfig",
  "type": "object",
  "properties": {
    "version": { "type": "number" },
    "target": {
      "type": "object",
      "properties": {
        "baseURL": { "type": "string" },
        "apiBase": { "type": "string" }
      },
      "required": ["baseURL"]
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string" },
          "totpSecret": { "type": "string" },
          "displayName": { "type": "string" },
          "enabled": { "type": "boolean" }
        },
        "required": ["username", "password", "displayName"]
      }
    },
    "exploration": {
      "type": "object",
      "properties": {
        "maxPagesPerRole": { "type": "number" },
        "maxDepth": { "type": "number" },
        "pageTimeoutMs": { "type": "number" },
        "formFuzzTimeoutMs": { "type": "number" },
        "totalTimeoutMs": { "type": "number" },
        "screenshotOnEveryPage": { "type": "boolean" },
        "headless": { "type": "boolean" }
      }
    },
    "features": {
      "type": "object",
      "properties": {
        "formFuzzing": { "type": "boolean" },
        "apiProbing": { "type": "boolean" },
        "accessibilityScan": { "type": "boolean" },
        "mobileViewport": { "type": "boolean" },
        "runComparison": { "type": "boolean" },
        "notifications": { "type": "boolean" }
      }
    }
  }
}
