  "cards": [
    {
      "dot": "emerald",
      "title": "Role 1: Onboarding Officer (Sukesh)",
      "items": [
        "Onboarding Officer fills Steps 1 to 7 and reviews/submits in Step 8 to generate unique MRN (Status: Submitted)",
        "If returned by Compliance, the application routes to dedicated 'Returned for clarification' list (never Drafts)",
        "Officer clicks 'Resume editing' to modify details, and re-submits through Step 8"
      ]
    },
    {
      "dot": "amber",
      "title": "Role 2: Compliance (bhanu) & eMcREY Screening",
      "items": [
        "Decision 1 (Return for Clarification): Routes back to Onboarding clarification queue with remarks",
        "Decision 2 (Reject): Moves record immediately to the Universal Rejected List",
        "Decision 3 (Compliance On-Hold): Stored in Compliance On-hold list until 'Release from Hold' is triggered",
        "Decision 4 (Approve & Forward): Dispatches merchant to eMcREY background screening (CLEAR, ON-HOLD, HIT)"
      ]
    },
    {
      "dot": "rose",
      "title": "Role 3: Final Approver (uttamnadh) & Universal Registers",
      "items": [
        "eMcREY returns CLEAR, ON-HOLD, or HIT. If ON-HOLD or HIT, Approver decision is strictly LOCKED",
        "Decision 1 (Direct Approve & Activate): Immediately publishes merchant to the Active directory & Approved register",
        "Decision 2 (Final On-Hold): Sends the merchant back to Compliance to inspect and release from hold",
        "Decision 3 (Reject): Places the record into the Universal Rejected List (visible to all 3 roles)"
      ]
    }
  ]
