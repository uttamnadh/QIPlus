  "cards": [
    {
      "dot": "emerald",
      "title": "Role 1: Onboarding Officer (Sukesh)",
      "items": [
        "Completes Steps 1 to 7 and reviews/submits in Step 8 to generate unique MRN (Status: Submitted)",
        "If returned by Compliance, application routes to dedicated 'Returned for clarification' list (never Drafts)",
        "Officer clicks 'Resume editing' to update flagged fields/documents and re-submits through Step 8"
      ]
    },
    {
      "dot": "amber",
      "title": "Role 2: Compliance (bhanu) & eMcREY Screening",
      "items": [
        "Decision 1 (Return for Clarification): Routes back to Onboarding clarification queue with remarks",
        "Decision 2 (Reject): Moves record immediately to the Universal Rejected List",
        "Decision 3 (Compliance On-Hold): Stored in Compliance On-hold list until 'Release from hold' resumes verification",
        "Decision 4 (Approve & Forward): Dispatches application to eMcREY AML screening (CLEAR, ON-HOLD, HIT)"
      ]
    },
    {
      "dot": "rose",
      "title": "Role 3: Final Approver (uttamnadh) & Universal Registers",
      "items": [
        "eMcREY HIT or ON-HOLD: Decision is LOCKED (notes and buttons disabled; Approver cannot decide)",
        "Decision 1 (Direct Approve & Activate): Published to Active Merchant Directory & Approved Merchants",
        "Decision 2 (Final On-Hold): Moves BACK to Compliance to inspect and click 'Release on hold'",
        "Decision 3 (Reject): Moves to Universal Rejected List (accessible to Onboarding, Compliance, and Approver)"
      ]
    }
  ]
